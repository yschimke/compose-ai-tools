# Installed by compose-preview. A copy that differs is kept, never overwritten.
#
# Prints compose-preview's build-artifacts documents (compose-preview-contracts'
# `build-artifacts-protocol`, schema 1: a JVM/Desktop target) for every
# selected JVM library, after building and materializing the jars they name:
#
#   buck2 bxl //.compose-preview/buck/compose_preview.bxl:artifacts -- \
#     --target //app:app --target //lib/...
#
# Output is {"targets": [document, ...]} on stdout. Paths are relative to the
# project root, the execution root the CLI resolves them against.

load("@prelude//java:java_providers.bzl", "JavaLibraryInfo", "JavaPackagingInfo")

def _label(label) -> str:
    return str(label.raw_target())

def _artifacts(ctx: bxl.Context):
    kinds = regex(ctx.cli_args.kinds)
    documents = []
    for node in ctx.configured_targets(ctx.cli_args.target):
        # `prelude//rules.bzl:kotlin_library` -> `kotlin_library`
        if not kinds.match(node.rule_type.split(":")[-1]):
            continue
        providers = ctx.analysis(node.label).providers()
        if JavaLibraryInfo not in providers or JavaPackagingInfo not in providers:
            continue
        library = providers[JavaLibraryInfo].library_output
        packaging = providers[JavaPackagingInfo].packaging_deps
        if library == None or packaging == None:
            continue

        # The target's own jar first, then its runtime closure in classpath order.
        runtime = [library.full_library]
        owners = {}
        for dep in packaging.traverse():
            if dep.jar == None or dep.jar in runtime:
                continue
            runtime.append(dep.jar)
            owners[dep.jar] = _label(dep.label)
        ensured = ctx.output.ensure_multiple(runtime)
        documents.append({
            "schemaVersion": 1,
            "target": _label(node.label),
            "configuration": str(node.label.config()),
            "projectJars": [ensured[0]],
            "runtimeJars": ensured,
            "sourceFiles": [
                get_path_without_materialization(source, ctx)
                for source in node.sources()
            ],
            "dataFiles": [],
            "runtimeJarOwners": {
                ensured[index]: owners[jar]
                for index, jar in enumerate(runtime)
                if jar in owners
            },
        })
    ctx.output.print_json({"targets": documents})

artifacts = bxl_main(
    impl = _artifacts,
    cli_args = {
        "kinds": cli_args.string(
            default = "^(kotlin_library|java_library)$",
            doc = "Regex over rule names. A target of another rule is skipped.",
        ),
        "target": cli_args.list(
            cli_args.string(),
            doc = "Labels and patterns, as on a build command line. Repeatable.",
        ),
    },
)
