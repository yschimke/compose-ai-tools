<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Connect to the serve instance over the LAN + discover it via mDNS/NSD. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Tapping a `composeai://session?...` link opens straight into the session. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="composeai" android:host="session" />
            </intent-filter>
            <!--
              No http(s) VIEW filter: serve runs on arbitrary LAN hosts, so a host-less filter would
              match every web URL and hijack unrelated browser links (Android ignores path attributes
              without a host). A pasted/clicked serve viewer URL (`http(s)://host/p/{id}?token=…`) is
              still accepted — paste it into the connect screen, which parses it via SessionLink.parse.
            -->
        </activity>
    </application>
</manifest>
