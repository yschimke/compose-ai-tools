<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      The session viewer connects to `compose-preview serve` over plaintext ws:// / http:// on the
      trusted LAN (the token in the link is the gate, not TLS). Serve binds to arbitrary private IPs,
      so cleartext can't be scoped to a fixed host and is permitted app-wide. A `wss://`/`https://`
      link still uses TLS. Tighten this to your serve host(s) if you run the viewer beyond a dev LAN.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
