{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schimke.ee/composeai/render-trace.schema.json",
  "title": "RenderTrace",
  "description": "Payload for the `render/trace` data product: the phase breakdown of a render derived from its metrics. Kotlin source of truth: RenderTraceDataProduct.payloadFrom() in :data-render-core (the payload is assembled dynamically, not from a @Serializable class).",
  "x-composeai": {
    "kind": "render/trace",
    "schemaVersion": 1,
    "kotlinType": "ee.schimke.composeai.data.render.RenderTraceDataProduct",
    "kotlinConst": "RenderTraceDataProduct.SCHEMA_VERSION",
    "example": "schema/examples/render-trace.json"
  },
  "definitions": {
    "RenderPhase": {
      "type": "object",
      "required": ["name", "startMs", "durationMs"],
      "properties": {
        "name": { "type": "string" },
        "startMs": { "type": "integer" },
        "durationMs": { "type": "integer" }
      }
    },
    "RenderTrace": {
      "type": "object",
      "required": ["totalMs", "phases", "metrics"],
      "properties": {
        "totalMs": { "type": "integer" },
        "phases": { "type": "array", "items": { "$ref": "#/definitions/RenderPhase" } },
        "metrics": { "type": "object", "additionalProperties": { "type": "integer" }, "description": "Flattened metric name -> value." }
      }
    }
  },
  "$ref": "#/definitions/RenderTrace"
}
