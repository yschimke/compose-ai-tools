# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
# Eclipse-style compile output (IntelliJ writes this when "Use Build and run
# using: IDE" is selected; Gradle puts its output in build/ instead).
bin/

# Kotlin
.kotlin/

# Java
*.class
hs_err_pid*
replay_pid*

# OS
.DS_Store
Thumbs.db

# AI
# `.claude/` holds two different kinds of thing. The repo's shared agent config
# — hooks, settings, and the repo-local skills under `skills/` — is checked in
# and is what makes a session behave the same for everyone. Everything else is
# per-machine session state. Ignore the directory by default and re-include the
# shared parts, so a new skill lands in git instead of silently staying local.
.claude/*
!.claude/hooks/
!.claude/settings.json
!.claude/skills/
.claude/settings.local.json
.gemini/

# Local properties
local.properties

# Node
node_modules/

# The preview-server harness (the serve page captures + the lane/playground/bundle-upload specs),
# moved out of the extension's harness. Same artifacts, new home.
preview-server/preview-harness/node_modules/
preview-server/preview-harness/out/
preview-server/preview-harness/test-results/
preview-server/preview-harness/test-results-serve-lanes/
preview-server/preview-harness/playwright-report/
preview-server/preview-harness/.last-run.json
*.vsix

# Python (for .github/actions/lib/ scripts and their tests)
__pycache__/
*.pyc

# Jekyll site (built artefacts under site/)
site/_site/
site/.jekyll-cache/
site/.jekyll-metadata
site/Gemfile.lock
site/vendor/

# Daemon preview-history archive — written by the daemon's `HistoryManager` when running
# (sysprop `composeai.daemon.historyDir`). Since #3407 the default lives OUTSIDE the working
# tree, under `$XDG_CACHE_HOME/composeai/history/` — nothing new lands here. The pattern stays
# for checkouts that still carry a pre-#3407 `<moduleDir>/.compose-preview-history/`, which the
# daemon keeps using when present. Ignore at any depth.
.compose-preview-history/

# CI checks the extension out here so the cross-repo daemon-launch schema check is real.
.compose-preview-vscode/
