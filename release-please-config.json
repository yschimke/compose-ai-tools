{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "compose-ai-tools",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        ".github/actions/install/README.md",
        "vscode-extension/README.md",
        "docs/RELEASING.md",
        "site/index.md",
        {
          "type": "generic",
          "path": ".github/actions/preview-baselines/action.yml"
        },
        {
          "type": "generic",
          "path": ".github/actions/preview-comment/action.yml"
        }
      ]
    },
    "clients": {
      "package-name": "compose-ai-tools-clients",
      "component": "clients",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        {
          "type": "generic",
          "path": "clients/mobile/build.gradle.kts"
        },
        {
          "type": "generic",
          "path": "clients/wear/build.gradle.kts"
        }
      ]
    }
  }
}
