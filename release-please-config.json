{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "separate-pull-requests": true,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "compose-ai-tools",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "exclude-paths": ["clients"],
      "draft": true,
      "extra-files": [
        ".github/actions/install/README.md",
        ".github/actions/apply/README.md",
        "vscode-extension/README.md",
        "docs/RELEASING.md",
        "site/index.md",
        {
          "type": "generic",
          "path": ".github/actions/preview-baselines/action.yml"
        },
        {
          "type": "generic",
          "path": ".github/actions/preview-comment/action.yml"
        },
        {
          "type": "generic",
          "path": "deploy/image/Dockerfile"
        },
        {
          "type": "generic",
          "path": ".github/workflows/preview-host-image.yml"
        }
      ]
    }
  }
}
