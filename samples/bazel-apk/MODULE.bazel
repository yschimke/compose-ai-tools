# Bazel sample — Android Compose APK target (opt-in, known-fragile).
#
# Pulls rules_kotlin / rules_android / rules_jvm_external to compile a
# tiny `@Composable @Preview` + `@NotificationPreview` into a real APK.
# Pins are conservative because the Compose compiler plugin +
# rules_kotlin combination is openly broken on Kotlin 2.x
# (bazelbuild/rules_kotlin#1388). We stay on Kotlin 1.9.x + standalone
# Compose Compiler 1.5.x for now. rules_kotlin 1.9.x in turn predates
# the Bazel 8 native-symbol cleanup (`JavaPluginInfo` moved into
# `@rules_java`), so this module pins Bazel 7 via `.bazelversion`.
# When rules_kotlin#1388 is fixed we can step both pins forward in one
# go.
#
# Kept in a sibling directory to `samples/bazel/` (resources-only) so the
# Android SDK / Maven toolchain wiring here doesn't leak into the
# resources job's module evaluation. The APK target is not on the
# default CI path — see `.github/workflows/bazel.yml` for the opt-in
# `bazel-build-apk` job.

module(
    name = "compose_ai_tools_bazel_apk_sample",
    version = "0.0.0",
)

# --- Android / Kotlin / Compose toolchain ---
# Versions verified to exist on Bazel Central Registry as of late 2025.
# Compose artifact versions are starting points; transitives are
# resolved by rules_jvm_external.

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_jvm_external", version = "6.10")
bazel_dep(name = "rules_kotlin", version = "1.9.6")
bazel_dep(name = "rules_android", version = "0.7.2")

# Android SDK — picks up $ANDROID_HOME from the environment. On the
# GitHub `ubuntu-latest` runner, prefer
# `android-actions/setup-android@v4` over the pre-installed SDK for
# determinism.
android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
use_repo(android_sdk_repository_extension, "androidsdk")
register_toolchains("@androidsdk//:sdk-toolchain", "@androidsdk//:all")

# Maven artifact graph. No `lock_file =` because the hermetic-pin
# workflow (`REPIN=1 bazel run @maven//:pin`) isn't usable until the
# rules_kotlin/Compose blocker (bazelbuild/rules_kotlin#1388) lifts and
# we can drive a successful resolution to capture. Until then the build
# resolves Maven on every run; the workflow is opt-in and
# `continue-on-error: true`, so the non-hermetic cost is bounded.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "androidx.activity:activity-compose:1.9.3",
        "androidx.compose.compiler:compiler:1.5.15",
        "androidx.compose.foundation:foundation:1.7.5",
        "androidx.compose.material3:material3:1.3.1",
        "androidx.compose.runtime:runtime:1.7.5",
        "androidx.compose.ui:ui:1.7.5",
        "androidx.compose.ui:ui-tooling-preview:1.7.5",
        "androidx.core:core-ktx:1.13.1",
    ],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
use_repo(maven, "maven")
