load("//:compose_preview.bzl", "discover_resources")

# Expose the placeholder discover script as a plain source file so
# the rule can stream it into a `run_shell` action. We deliberately
# avoid `sh_binary` here — it's no longer a native rule in Bazel 8
# (lives in @rules_shell) and pulling in a third-party module for
# one throwaway script isn't worth it. The script is replaced by
# `compose-preview discover-resources` once that lands (#1253).
exports_files(["_discover.sh"])

discover_resources(
    name = "app_resources",
    srcs = glob([
        "app/res/drawable/*.xml",
        "app/res/drawable-*/*.xml",
        "app/res/mipmap-*/*.xml",
        # values/ is included so the rule exercises the
        # skip-classification path — these files have a `<resources>`
        # root and are dropped by the discover action.
        "app/res/values/*.xml",
    ]),
    module = "//samples/bazel:app",
    variant = "main",
)

filegroup(
    name = "all",
    srcs = [":app_resources"],
)

# --- Android Compose APK target (opt-in, known-fragile) ---
#
# Everything below this point is part of the second sample scope: a
# real APK built from Kotlin sources via rules_kotlin + rules_android.
# Kept in this BUILD.bazel (rather than a nested `app/BUILD.bazel`) so
# the `app/res/...` glob above doesn't cross a package boundary. See
# MODULE.bazel for the version-pin rationale and #1388 risk note.

load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@rules_kotlin//kotlin:core.bzl", "kt_compiler_plugin")
load("@rules_android//rules:rules.bzl", "android_binary")

kt_compiler_plugin(
    name = "compose_compiler_plugin",
    id = "androidx.compose.compiler",
    target_embedded_compiler = True,
    deps = ["@maven//:androidx_compose_compiler_compiler"],
)

kt_android_library(
    name = "bazel_sample_lib",
    srcs = glob(["app/src/main/kotlin/**/*.kt"]),
    custom_package = "com.example.bazelsample",
    manifest = "app/src/main/AndroidManifest.xml",
    plugins = [":compose_compiler_plugin"],
    deps = [
        "@maven//:androidx_activity_activity_compose",
        "@maven//:androidx_compose_foundation_foundation",
        "@maven//:androidx_compose_material3_material3",
        "@maven//:androidx_compose_runtime_runtime",
        "@maven//:androidx_compose_ui_ui",
        "@maven//:androidx_compose_ui_ui_tooling_preview",
        "@maven//:androidx_core_core_ktx",
    ],
)

android_binary(
    name = "bazel_sample_apk",
    custom_package = "com.example.bazelsample",
    manifest = "app/src/main/AndroidManifest.xml",
    deps = [":bazel_sample_lib"],
)
