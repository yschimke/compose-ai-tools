load("//:compose_preview.bzl", "discover_resources")

# Placeholder discover action — shell script that mirrors the wire
# format produced by `discoverAndroidResources`. Swapped for the
# `compose-preview discover-resources` CLI subcommand once it lands
# (issue #1253).
sh_binary(
    name = "_discover",
    srcs = ["_discover.sh"],
    visibility = ["//visibility:public"],
)

discover_resources(
    name = "app_resources",
    srcs = glob([
        "app/res/drawable/*.xml",
        "app/res/drawable-*/*.xml",
        "app/res/mipmap-*/*.xml",
        # values/ is included so the rule exercises the
        # skip-classification path — these files have a `<resources>`
        # root and are dropped by the discover action.
        "app/res/values/*.xml",
    ]),
    module = "//samples/bazel:app",
    variant = "main",
)

filegroup(
    name = "all",
    srcs = [":app_resources"],
)
