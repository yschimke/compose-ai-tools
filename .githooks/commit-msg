#!/usr/bin/env bash
# Reject commit messages that contain agent-attribution spam or that don't
# follow Conventional Commits. Install with `scripts/install-git-hooks.sh`.

set -euo pipefail

msg_file="$1"

# Strip git's comment lines (those starting with '#') before inspecting.
msg_body="$(grep -v '^#' "$msg_file" || true)"

# Allow auto-generated messages (merge, revert, fixup!, squash!) through
# untouched — they're produced by git itself and not authored prose.
first_line="$(printf '%s\n' "$msg_body" | sed -n '1{/^$/d;p;q;}')"
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *)
    exit 0
    ;;
esac

fail() {
  printf '\ncommit-msg hook rejected this commit:\n\n  %s\n\n' "$1" >&2
  exit 1
}

# 1. Reject AI-agent *identity* — but only the parts that make git history
#    claim an agent did the work. Links to an agent session (claude.ai/code),
#    "🤖 Generated with …" footers, and prose are fine and NOT matched.
#    Keep AGENT_NAME / AGENT_EMAIL in sync with
#    .github/workflows/no-agent-attribution.yml.
AGENT_NAME='(Claude|Codex|ChatGPT|Copilot|Gemini)'
AGENT_EMAIL='noreply@(anthropic|openai)\.com'

# 1a. A Co-authored-by: trailer (start-of-line) naming an agent or using an
#     agent no-reply email.
if printf '%s\n' "$msg_body" \
     | grep -iE '^[[:space:]]*Co-authored-by:' \
     | grep -Eqi "Co-authored-by:[[:space:]]*${AGENT_NAME}|${AGENT_EMAIL}"; then
  fail "agent Co-authored-by trailer detected. Commits are attributed solely
to the human committer — remove the agent co-author line and recommit.
(Session links / 'Generated with' footers are fine; an agent co-author is not.)"
fi

# 1b. The commit's own author / committer identity must not be an agent email.
author_email="$(git var GIT_AUTHOR_IDENT   | sed -n 's/.*<\([^>]*\)>.*/\1/p')"
committer_email="$(git var GIT_COMMITTER_IDENT | sed -n 's/.*<\([^>]*\)>.*/\1/p')"
for email in "$author_email" "$committer_email"; do
  if printf '%s' "$email" | grep -Eqi "$AGENT_EMAIL"; then
    fail "commit identity email '$email' is an AI agent. Set git
user.name/user.email to your own identity and recommit."
  fi
done

# 2. Enforce Conventional Commits on the subject line.
# Format: type(scope)?!?: description   (scope optional, '!' marks breaking change)
subject="$first_line"
if [ -z "$subject" ]; then
  fail "empty commit message."
fi

conv_re='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^)]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -Eq "$conv_re"; then
  fail "subject must follow Conventional Commits, e.g. 'fix(scope): message'.
Allowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test.
Got: $subject"
fi

exit 0
