{
  "ignorePaths": [
    "docs/**",
    "**/*.md"
  ],
  "globalPaths": [
    ".github/ci/serve-lanes-paths.json",
    ".github/ci/path-scope.py",
    ".github/workflows/serve-lanes-e2e.yml",
    "cli/src/main/kotlin/ee/schimke/composeai/cli/serve/**",
    "cli/src/main/kotlin/ee/schimke/composeai/cli/ServeCommand.kt",
    "daemon/core/**",
    "render-session/**",
    "render-session-subprocess/**",
    "gradle/libs.versions.toml"
  ],
  "groups": {
    "desktop": [
      "daemon/desktop/**",
      "renderers/desktop/**",
      "preview-server/preview-harness/serve-lanes.*",
      "preview-server/preview-harness/serve-lanes-boot.sh"
    ],
    "android": [
      "daemon/android/**",
      "renderers/android/**",
      "preview-server/preview-harness/serve-lanes.*",
      "preview-server/preview-harness/serve-android-lane-boot.sh",
      "samples/android-live-lane/**",
      "cli/src/main/kotlin/ee/schimke/composeai/cli/AndroidBundleResources.kt",
      "cli/src/main/kotlin/ee/schimke/composeai/cli/AndroidBundleLaunch.kt"
    ],
    "bundle": [
      "cli/src/main/kotlin/ee/schimke/composeai/cli/BundleCommand.kt",
      "gradle-plugin/**",
      "preview-server/preview-harness/bundle-upload.*",
      "preview-server/preview-harness/bundle-upload-boot.sh"
    ],
    "playground": [
      "daemon/android/**",
      "renderers/android/**",
      "preview-server/preview-harness/playground.*",
      "preview-server/preview-harness/playground-boot.sh",
      "samples/android-live-lane/**",
      "cli/src/main/kotlin/ee/schimke/composeai/cli/AndroidBundleResources.kt",
      "cli/src/main/kotlin/ee/schimke/composeai/cli/AndroidBundleLaunch.kt"
    ]
  }
}
