{
  "ignorePaths": [
    "docs/**",
    "site/**",
    "renders/**",
    "**/*.md",
    "**/*.png",
    "**/*.jpg",
    "**/*.gif",
    "LICENSE",
    ".gitignore",
    ".gitattributes"
  ],
  "globalPaths": [
    ".github/ci/ci-paths.json",
    ".github/ci/path-scope.py",
    ".github/workflows/ci.yml",
    "build-logic/**",
    "gradle/**",
    "settings.gradle*",
    "build.gradle*",
    "gradle.properties",
    "gradlew",
    "gradlew.bat"
  ],
  "groups": {
    "plugin_tests": [
      "gradle-plugin/**",
      "api/preview-annotations/**",
      "api/preview-data-api/**"
    ],
    "renderer_android_tests": [
      "renderers/android/**",
      "data/layoutinspector/**",
      "data/render/**"
    ],
    "rc_player_tests": [
      "scripts/design-artifacts/rc-compare*",
      "scripts/design-artifacts/rc-chromium*",
      "scripts/design-artifacts/rc-cmp-wasm-*",
      "scripts/design-artifacts/rc-clock*",
      "scripts/design-artifacts/rc-settle*",
      ".github/workflows/design-artifacts-reusable.yml"
    ],
    "module_unit_tests": [
      "api/**",
      "bundle-viewer/**",
      "bundle/**",
      "cli/**",
      "common/**",
      "daemon/**",
      "data/**",
      "gradle-plugin/**",
      "render-session/**",
      "renderers/**",
      "runtimes/**"
    ],
    "functional_tests": [
      "gradle-plugin/**",
      "api/preview-annotations/**",
      "api/preview-data-api/**",
      "renderers/**"
    ],
    "build_samples": [
      "samples/**",
      "gradle-plugin/**",
      "api/preview-annotations/**",
      "api/preview-data-api/**",
      "renderers/**",
      "runtimes/**",
      "data/**"
    ],
    "build_cli": [
      "cli/**",
      "bundle-viewer/**",
      "bundle/**",
      "common/**",
      "api/**",
      "data/**",
      "render-session/**",
      "trust/**"
    ],
    "spatial_scene": [
      "schema/spatial-scene.schema.json",
      "schema/xr-render-service.schema.json",
      "api/preview-data-api/src/**",
      "scripts/codegen/gen-spatial-scene.mjs",
      "scripts/codegen/gen-xr-render-service.mjs",
      "renderers/xr-client/src/**"
    ],
    "actions_tests": [
      ".github/actions/**",
      ".github/ci/**",
      ".github/design-artifacts-driver-pin.txt",
      ".github/scripts/**",
      ".github/workflows/**",
      "scripts/design-artifacts/**",
      "gradle/libs.versions.toml",
      "scripts/check-daemon-launch-schema.py",
      "scripts/daemon-launch-schema-allowlist.json",
      "scripts/test_check_daemon_launch_schema.py",
      "settings.gradle.kts",
      "**/*.kt",
      "**/*.ts"
    ],
    "design_artifacts": [
      "design-map/**",
      "scripts/design-artifacts/**",
      ".github/actions/lib/**"
    ]
  }
}
