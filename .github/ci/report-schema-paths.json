{
  "ignorePaths": [
    "api/**",
    "build-logic/**",
    "bundle-viewer/**",
    "cli/**",
    "common/**",
    "deploy/**",
    "docs/**",
    "gradle-plugin/**",
    "gradle/**",
    "render-session/**",
    "renders/**",
    "runtimes/**",
    "samples/**",
    "site/**",
    "**/*.md",
    "**/*.kt",
    "**/*.kts",
    "**/*.java",
    "**/*.png",
    "LICENSE",
    ".gitignore",
    ".gitattributes"
  ],
  "globalPaths": [
    ".github/ci/report-schema-paths.json",
    ".github/ci/path-scope.py",
    ".github/workflows/report-schemas.yml"
  ],
  "groups": {
    "validate": [
      "schema/**",
      "scripts/validate-report-schemas.mjs"
    ]
  }
}
