{
    "name": "compose-preview-server-harness",
    "version": "0.0.0",
    "private": true,
    "description": "Playwright harness for `compose-preview serve`: page captures for the visual-diff bot, and the lane / playground / bundle-upload end-to-end specs.",
    "type": "module",
    "scripts": {
        "harness:pages": "playwright test -c playwright.config.mjs pages-snapshot.spec.mjs",
        "harness:compare": "playwright test -c playwright.config.mjs format-compare-scorer.spec.mjs",
        "harness:serve-lanes": "playwright test -c serve-lanes.config.mjs",
        "harness:playground": "playwright test -c playground.config.mjs",
        "harness:bundle-upload": "playwright test -c bundle-upload.config.mjs"
    },
    "devDependencies": {
        "@playwright/test": "~1.62.0"
    }
}
